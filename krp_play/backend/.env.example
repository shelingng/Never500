# Backend-only secrets. Copy this file to .env and fill in real values.
# Never put these in the Flutter app or commit the real .env file.

PORT=3000

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: bypasses Row Level Security, server use only
SUPABASE_KEY=replace_with_supabase_service_role_key

# --- Billplz (Settings > Keys & Integration) ---
# Sandbox: https://www.billplz-sandbox.com/api/v3
# Production: https://www.billplz.com/api/v3
BILLPLZ_API_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_SECRET_KEY=replace_with_billplz_api_secret_key
BILLPLZ_X_SIGNATURE_KEY=replace_with_billplz_x_signature_key
# Billing > Collections
BILLPLZ_COLLECTION_ID=replace_with_billplz_collection_id
# Public URL Billplz calls after payment (e.g. your devtunnel URL + /api/webhook)
BILLPLZ_CALLBACK_URL=https://your-backend.example.com/api/webhook
# Where the user's browser goes after paying
BILLPLZ_REDIRECT_URL=https://your-backend.example.com/payment/complete
