# Backend-only Billplz configuration.
# Do not add these secrets to Flutter assets or ship them in the mobile app.

BILLPLZ_ENV=sandbox
BILLPLZ_API_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_API_KEY=replace_with_billplz_api_key
BILLPLZ_X_SIGNATURE_KEY=replace_with_billplz_x_signature_key
BILLPLZ_COLLECTION_ID=replace_with_billplz_collection_id
BILLPLZ_CALLBACK_URL=https://your-backend.example.com/billplz/callback
BILLPLZ_REDIRECT_URL=https://your-app.example.com/payment/complete
